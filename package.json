{
  "name": "eslint-plugin-fractal",
  "version": "0.0.0-development",
  "description": "ESLint plugin that enforces the Fractal React application structure: component import boundaries and at most one detected top-level React component per file.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "react",
    "fractal",
    "architecture",
    "import-boundaries"
  ],
  "license": "MIT",
  "author": "Lauri Lavanti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapanti/eslint-plugin-fractal.git"
  },
  "homepage": "https://github.com/lapanti/eslint-plugin-fractal#readme",
  "bugs": {
    "url": "https://github.com/lapanti/eslint-plugin-fractal/issues"
  },
  "type": "module",
  "sideEffects": false,
  "packageManager": "npm@11.19.0",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:package": "node --run build && node scripts/verify-package.mjs && publint && attw --pack .",
    "check": "node --run typecheck && node --run lint && node --run format:check && node --run test:coverage",
    "release": "semantic-release",
    "prepublishOnly": "node --run build"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.0.0"
  },
  "peerDependencies": {
    "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "@typescript-eslint/parser": "8.67.0",
    "@typescript-eslint/rule-tester": "8.67.0",
    "@vitest/coverage-v8": "4.1.11",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.9.1",
    "eslint-plugin-eslint-plugin": "7.6.2",
    "eslint-plugin-n": "18.3.0",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "semantic-release": "25.0.9",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
