{
  "name": "eslint-plugin-fractal",
  "version": "0.2.1",
  "description": "ESLint plugin that enforces the Fractal React application structure: component import boundaries and at most one detected top-level React component per file.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "react",
    "fractal",
    "architecture",
    "import-boundaries"
  ],
  "license": "MIT",
  "author": "Lauri Lavanti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapanti/eslint-plugin-fractal.git"
  },
  "homepage": "https://github.com/lapanti/eslint-plugin-fractal#readme",
  "bugs": {
    "url": "https://github.com/lapanti/eslint-plugin-fractal/issues"
  },
  "type": "module",
  "sideEffects": false,
  "packageManager": "npm@11.17.0",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.0.0"
  },
  "peerDependencies": {
    "eslint": ">=8.57.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "9.39.5",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@types/node": "20.19.43",
    "@typescript-eslint/parser": "8.67.0",
    "@typescript-eslint/rule-tester": "8.67.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "semantic-release": "24.2.9",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "2.1.9"
  }
}
