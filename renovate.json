{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rebaseWhen": "behind-base-branch",
  "automergeStrategy": "rebase",
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "matchCurrentVersion": ">=1.0.0",
      "minimumReleaseAge": "3 days",
      "addLabels": ["automerge-approved"],
      "automerge": true
    },
    {
      "description": "typescript-eslint peers on typescript >=4.8.4 <6.1.0; newer majors cannot install.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    },
    {
      "description": "packageManager tracks the npm bundled with the Node lines we test.",
      "matchPackageNames": ["npm"],
      "allowedVersions": "<12"
    }
  ]
}
